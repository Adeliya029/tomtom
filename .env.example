# TomTom Traffic Index live endpoint (public, no API key required)
TOMTOM_REGIONS=IDN_jakarta_new
TOMTOM_BASE_URL=https://www.tomtom.com
TOMTOM_TIMEOUT=30
TOMTOM_RETRIES=3
TOMTOM_REQUEST_DELAY_SECONDS=1.0

DATA_DIR=./data

# Azure Blob Storage (dipakai oleh workflow CD lewat az CLI, bukan oleh Python).
# Untuk tes lokal: az login, lalu jalankan az storage blob upload-batch.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=tomtom-data

# Optional. Only needed if you later switch to the official TomTom API.
TOMTOM_API_KEY=
